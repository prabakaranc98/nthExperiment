# ─── Experiment Tracking ─────────────────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=nthexperiment
WANDB_ENTITY=

# ─── HuggingFace ──────────────────────────────────────────────────────────────
HF_TOKEN=
HF_HOME=~/.cache/huggingface

# ─── OpenAI / Anthropic ───────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── GPU / CUDA ───────────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
# NCCL_DEBUG=INFO                     # uncomment for distributed debugging
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ─── JAX ──────────────────────────────────────────────────────────────────────
XLA_PYTHON_CLIENT_PREALLOCATE=false
# XLA_FLAGS=--xla_gpu_cuda_data_dir=/usr/local/cuda

# ─── Remote GPU / SSH ─────────────────────────────────────────────────────────
GPU_HOST=
GPU_USER=
GPU_KEY=~/.ssh/id_rsa
GPU_PORT=22
# Usage: ssh -i $GPU_KEY -p $GPU_PORT $GPU_USER@$GPU_HOST

# ─── Paths ────────────────────────────────────────────────────────────────────
DATA_DIR=~/data
CHECKPOINTS_DIR=~/checkpoints
LOGS_DIR=./logs

# ─── Misc APIs ────────────────────────────────────────────────────────────────
COMET_API_KEY=
NEPTUNE_API_TOKEN=
